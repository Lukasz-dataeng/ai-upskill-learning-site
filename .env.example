# Copy to .env (gitignored) and fill in your own values. Nothing here has a
# default, so a clone of this repo cannot deploy anywhere, or spend anyone
# else's LLM budget, until its owner fills this in.

# --- Deploying (scripts/publish.sh, via wrangler) ---------------------------
# A Cloudflare API token scoped to Account - Cloudflare Pages - Edit, and the
# account it belongs to. Both are yours; the deploy goes to your account.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
# The Pages project to deploy to. wrangler creates it on the first deploy.
CLOUDFLARE_PROJECT_NAME=
# The address publish.sh checks afterwards, e.g. https://<project>.pages.dev
SITE_URL=
# yes if the site sits behind a login (Cloudflare Access), no if it is public.
# With yes, publish.sh treats a plain 200 as a failure: the gate is off.
SITE_BEHIND_LOGIN=

# --- The agents (quiz, mock interview, topic pipeline) ----------------------
# An LLM gateway that speaks the Azure OpenAI shape. For EPAM DIAL this is
# https://ai-proxy.lab.epam.com and it is reachable only over the EPAM VPN.
DIAL_ENDPOINT=
# Your own key. A personal key is for one person: do not serve others with it.
DIAL_API_KEY=
# The default model, used by any agent not listed in agents/models.mjs.
DIAL_DEPLOYMENT_ID=
# Optional. Leave empty for models that reject temperature (newer GPT).
DIAL_TEMPERATURE=
